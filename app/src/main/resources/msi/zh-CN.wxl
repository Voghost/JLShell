  <String Id="WixUIProgressTextInstalling" Overridable="yes">正在安装 {0}</String>
  <String Id="WixUIProgressTextRemoving" Overridable="yes">正在移除 {0}</String>

  <!-- Feature selection -->
  <String Id="WixUIFeatureSelection" Overridable="yes">功能选择</String>
