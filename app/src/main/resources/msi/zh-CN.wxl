  <!-- Welcome -->
  <String Id="WixUIWelcome" Overridable="yes">欢迎使用 JLShell 安装向导</String>
  <String Id="WixUIWelcomeDescription" Overridable="yes">安装向导将在您的计算机上安装 JLShell。请单击"下一步"继续，或单击"取消"退出安装向导。</String>

  <!-- Verify ready -->
  <String Id="WixUIVerifyReady" Overridable="yes">准备安装</String>
